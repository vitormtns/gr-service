# Perfil e porta da API
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# PostgreSQL local do Supabase. Use um login runtime dedicado que possa assumir app_api.
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=app
DATABASE_RUNTIME_ROLE=app_api
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=1
DATABASE_CONNECTION_TIMEOUT=10000

# Supabase Auth. O stack local atual publica uma chave ES256 no endpoint JWKS.
SUPABASE_AUTH_MODE=JWKS
SUPABASE_AUTH_ALGORITHM=ES256
SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_AUTH_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_AUDIENCES=authenticated
SUPABASE_AUTH_TOKEN_ROLES=authenticated
SUPABASE_AUTH_CLOCK_SKEW=30s

# Use somente no backend quando um projeto legado exigir HMAC. Nunca versione o valor real.
SUPABASE_AUTH_JWT_SECRET=
